# Neon Postgres — org org-spring-sunset-28623562 · project young-math-54820541
# Dashboard: https://console.neon.tech/app/projects/young-math-54820541
# In the console: Connect → copy the connection string (use the pooled string for serverless / Next.js).
DATABASE_URL="postgresql://USER:PASSWORD@EP-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Cloudflare Workers (OpenNext): set the same value as a secret, e.g.
#   wrangler secret put DATABASE_URL
# Local preview with Wrangler can use `.dev.vars` (see https://developers.cloudflare.com/workers/configuration/secrets/)

# MongoDB Atlas (product MDX seed / future CMS)
# Atlas → Connect → Drivers → copy URI (replace <password>).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Database and collection name (defaults match src/lib/mongodb/env.ts if omitted)
MONGODB_DB="jayco"
MONGODB_COLLECTION="product_mdx"

# When MONGODB_URI is set and `product_mdx` has documents, the product catalog is built from MongoDB
# (no `content/products` folder required). Optional `content/products/<category>/category.json` still
# enriches category pages if that folder exists.

# Product page: in-browser MDX editor (server + client). Omit or set to "false" to hide.
NEXT_PUBLIC_PRODUCT_EDITOR="true"
# Optional: if set, saves require this passphrase (do not expose publicly).
PRODUCT_EDITOR_SECRET=""

# Optional: curl diagnostics for Mongo + MDX resolution (see src/app/api/diagnostics/product-mdx/route.ts)
PRODUCT_DIAGNOSTICS_SECRET=""
